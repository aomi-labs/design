 "cues": [
  {
   "s": 3.8,
   "e": 6.414,
   "text": "Aomi works across EVM and Solana without"
  },
  {
   "s": 6.454,
   "e": 9.781,
   "text": "making the user switch networks between steps."
  },
  {
   "s": 11.8,
   "e": 14.805,
   "text": "This single request combines a Base lending position,"
  },
  {
   "s": 14.845,
   "e": 18.352,
   "text": "a bridge to Arbitrum, and a Solana liquid-staking route."
  },
  {
   "s": 19.8,
   "e": 23.285,
   "text": "Aomi activates five protocol skills, checks both wallets,"
  },
  {
   "s": 23.325,
   "e": 26.715,
   "text": "and builds each leg on the chain where it belongs."
  },
  {
   "s": 27.8,
   "e": 29.99,
   "text": "On Base, an ordered four-transaction"
  },
  {
   "s": 30.03,
   "e": 31.497,
   "text": "simulation supplies four"
  },
  {
   "s": 31.537,
   "e": 33.607,
   "text": "USDC to Aave and routes another"
  },
  {
   "s": 33.647,
   "e": 35.925,
   "text": "four through Across to Arbitrum."
  },
  {
   "s": 36.525,
   "e": 41.696,
   "text": "The bridge quote returns 3.99215 USDC on Arbitrum."
  },
  {
   "s": 41.736,
   "e": 43.304,
   "text": "Delivery is not claimed;"
  },
  {
   "s": 43.344,
   "e": 47.36,
   "text": "the quote and source-chain calls are what were simulated."
  },
  {
   "s": 47.96,
   "e": 52.406,
   "text": "On Solana, account creation and a 0.05 SOL Marinade"
  },
  {
   "s": 52.446,
   "e": 55.765,
   "text": "stake pass together in one atomic simulation."
  },
  {
   "s": 56.365,
   "e": 59.782,
   "text": "The Kamino leg is withheld because the simulator cannot"
  },
  {
   "s": 59.822,
   "e": 63.423,
   "text": "validate spending newly minted mSOL in that same batch."
  },
  {
   "s": 63.463,
   "e": 65.973,
   "text": "Every transaction remains unsigned."
  },
  {
   "s": 66.573,
   "e": 68.72,
   "text": "One orchestration layer, multiple chains,"
  },
  {
   "s": 68.76,
   "e": 71.765,
   "text": "and simulation as the gate before wallet authority."
  }
 ],
