 "cues": [
  {
   "s": 3.8,
   "e": 6.762,
   "text": "Here's a small lending protocol: a pool,"
  },
  {
   "s": 6.802,
   "e": 10.423,
   "text": "a collateral token, an A M M, and a price oracle."
  },
  {
   "s": 10.463,
   "e": 12.18,
   "text": "Lenders supply USDC,"
  },
  {
   "s": 12.22,
   "e": 15.499,
   "text": "and borrowers post WGLD as collateral."
  },
  {
   "s": 16.099,
   "e": 19.334,
   "text": "The pool values that collateral through the oracle,"
  },
  {
   "s": 19.374,
   "e": 22.484,
   "text": "and the oracle just reads the A M M's spot price."
  },
  {
   "s": 22.524,
   "e": 25.835,
   "text": "A bug like that only shows up across contracts."
  },
  {
   "s": 26.435,
   "e": 27.666,
   "text": "We start a campaign."
  },
  {
   "s": 27.706,
   "e": 30.692,
   "text": "The harness has already seeded the whole deployed"
  },
  {
   "s": 30.732,
   "e": 33.355,
   "text": "protocol into the agent's simulation world,"
  },
  {
   "s": 33.395,
   "e": 37.195,
   "text": "with code, storage, and balances at their real addresses."
  },
  {
   "s": 37.795,
   "e": 39.398,
   "text": "The agent reads the source,"
  },
  {
   "s": 39.438,
   "e": 42.098,
   "text": "writes a threat model, and starts a campaign:"
  },
  {
   "s": 42.138,
   "e": 44.036,
   "text": "actors, actions in attack order,"
  },
  {
   "s": 44.076,
   "e": 46.421,
   "text": "and the properties that must hold."
  },
  {
   "s": 47.021,
   "e": 48.72,
   "text": "Each round, the app hands the"
  },
  {
   "s": 48.76,
   "e": 50.632,
   "text": "agent a batch of call sequences."
  },
  {
   "s": 50.672,
   "e": 52.66,
   "text": "It replays them in the simulation,"
  },
  {
   "s": 52.7,
   "e": 55.947,
   "text": "and every property is checked against the results."
  },
  {
   "s": 56.547,
   "e": 59.808,
   "text": "Under the tool calls, every runtime event is kept:"
  },
  {
   "s": 59.848,
   "e": 62.526,
   "text": "statuses, balance changes, probe outputs."
  },
  {
   "s": 62.566,
   "e": 64.598,
   "text": "Any result can be audited."
  },
  {
   "s": 65.198,
   "e": 67.532,
   "text": "The chat shows what the agent was told:"
  },
  {
   "s": 67.572,
   "e": 69.252,
   "text": "the world is already seeded,"
  },
  {
   "s": 69.292,
   "e": 72.075,
   "text": "so it never deploys or edits code itself."
  },
  {
   "s": 74.184,
   "e": 75.137,
   "text": "Then it lands."
  },
  {
   "s": 75.177,
   "e": 79.04,
   "text": "The agent buys WGLD to pump the spot price, deposits it,"
  },
  {
   "s": 79.08,
   "e": 82.415,
   "text": "and borrows far more than the collateral is worth."
  },
  {
   "s": 82.455,
   "e": 84.532,
   "text": "The app cuts the trace to three"
  },
  {
   "s": 84.572,
   "e": 86.907,
   "text": "calls and reproduces it twice."
  }
 ],
